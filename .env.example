# Anyanwu — copy to .env and fill in. Never commit a real .env.
# No secrets are needed to run the tests or the demo. The demo runs on
# test money in your browser. Mainnet steps need the items below, created
# by a human — never put a real key in chat or in the repo.

# --- QIE network (public, no secret) ---
# Mainnet is the default. Testnet is skipped: its faucet is offline and
# its RPC does not answer from here, and the hackathon needs mainnet.
# Mainnet chain 1990, RPC https://rpc1mainnet.qie.digital
# Testnet chain 1983, RPC https://rpc1testnet.qie.digital
NEXT_PUBLIC_QIE_NETWORK=mainnet
NEXT_PUBLIC_QIE_TESTNET_RPC_URL=https://rpc1testnet.qie.digital
NEXT_PUBLIC_QIE_MAINNET_RPC_URL=https://rpc1mainnet.qie.digital

# --- Stablecoin (public addresses, no secret) ---
# QUSDC on QIE mainnet, 6 decimals. Verified on-chain 2026-11-23
# (block 12,111,833): decimals 6, symbol/name "QUSDC".
NEXT_PUBLIC_QUSDC_MAINNET=0x3F43DA82eC9A4f5285F10FaF1F26EcA7319E5DA5
# QUSDC is NOT published for QIE testnet. Testnet uses our own test token
# (contracts/src/MockQUSDC.sol) — never on mainnet.
# Paste its address here only if a testnet deploy ever happens.
NEXT_PUBLIC_QUSDC_TESTNET=
# QIE ID (.qie names) on mainnet. Verified on-chain 2026-11-23:
# ERC-721, name "qie", symbol ".qie". Not deployed on testnet — names
# only show on mainnet, and only when the chain proves the wallet owns one.
NEXT_PUBLIC_QIE_ID_MAINNET=0x9aab56e7727af53A3131985BFB16d845319b7bdc

# --- Deployed Anyanwu contracts (paste after deploy; empty = demo mode) ---
NEXT_PUBLIC_TREASURY_TESTNET=
NEXT_PUBLIC_BATCHER_TESTNET=
NEXT_PUBLIC_STREAM_TESTNET=
NEXT_PUBLIC_TREASURY_MAINNET=
NEXT_PUBLIC_BATCHER_MAINNET=
NEXT_PUBLIC_STREAM_MAINNET=

# --- Deployer key for `forge script` (mainnet — real money) ---
# A fresh mainnet-only deployer wallet. Fund it with real QIE for gas
# before deploying (see README for the exact amount — the deploy is
# cheap, about 0.001 QIE at current gas). Only set this after an
# independent review of contracts/src/ and only with a small amount
# first. Never reuse a wallet that holds other money. Never commit this.
QIE_MAINNET_PRIVATE_KEY=
# Testnet deployer key, kept for completeness. Testnet is skipped for now.
# A fresh testnet-only wallet would be funded at https://www.qie.digital/faucet
# (2 test QIE a day) — the faucet was offline when last tried, 2026-11-23.
QIE_TESTNET_PRIVATE_KEY=
